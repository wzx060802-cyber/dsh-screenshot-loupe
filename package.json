{
  "name": "dsh-screenshot-loupe",
  "version": "1.1.0",
  "type": "module",
  "description": "On-screen area snip for the DeepSeek Harness composer, with a pixel loupe, crosshair guides, and in-place annotation. No runtime dependency beyond what Windows already ships.",
  "license": "MIT",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "screenshot",
    "snip",
    "loupe",
    "annotate"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wzx060802-cyber/dsh-screenshot-loupe.git"
  },
  "bugs": {
    "url": "https://github.com/wzx060802-cyber/dsh-screenshot-loupe/issues"
  },
  "homepage": "https://github.com/wzx060802-cyber/dsh-screenshot-loupe#readme",
  "scripts": {
    "check": "node --check index.js && node --check client.js"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "snip.cs",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-commands"
      ]
    }
  }
}
